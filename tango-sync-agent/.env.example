# Completá estos valores en un archivo .env en esta misma carpeta (copiá
# este archivo y renombralo a .env). Nunca subas el .env real a ningún lado.

TANGO_SQL_HOST="DFS01"
TANGO_SQL_PORT=""
TANGO_SQL_INSTANCE="SQL"
TANGO_SQL_DATABASE="Direct_Group"
TANGO_SQL_USER="dg_platform_reader"
TANGO_SQL_PASSWORD=""
TANGO_SQL_ENCRYPT="false"

# Mismo valor que TANGO_CONNECTOR_TOKEN en el .env de la app dg_platform.
TANGO_CONNECTOR_TOKEN=""
# URL pública de la Plataforma DG (sin barra final).
TANGO_AGENT_API_URL=""
