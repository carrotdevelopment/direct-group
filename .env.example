DATABASE_URL="postgresql://app:app@localhost:5432/dg_platform?schema=public"
# Isolated local database for the Excel migration. It keeps the current database intact.
EXCEL_DATABASE_URL="postgresql://app:app@localhost:5432/dg_platform_excel?schema=public"
# Runtime source used by the current API routes: "excel" or "postgresql".
DG_DATA_SOURCE="postgresql"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
UPLOAD_DIR="./storage/uploads"
NEXT_PUBLIC_DEMO_MODE="true"

# Excel database folder. The repository-local default is shown below.
# Keep operational files in this ignored folder, or replace it with an
# absolute path to a private OneDrive/Drive folder.
DG_LOCAL_DB_DIR="./local-data/BASE DE DATOS DG/En uso"

# Read-only SQL Server login for Tango Gestion, used to test/pull the
# ingresos query directly (see scripts/tango-sql-test.ts). Never commit
# real values here; fill them in .env / .env.local only.
TANGO_SQL_HOST=""
TANGO_SQL_PORT="1433"
TANGO_SQL_INSTANCE=""
TANGO_SQL_DATABASE="Direct_Group"
TANGO_SQL_USER=""
TANGO_SQL_PASSWORD=""
TANGO_SQL_ENCRYPT="false"

# Shared secret between this app and the DG Tango Sync Agent
# (scripts/tango-sync-agent.ts). Must be at least 32 characters and identical
# on both sides. TANGO_AGENT_API_URL is where the agent reaches this app.
TANGO_CONNECTOR_TOKEN=""
TANGO_AGENT_API_URL="http://localhost:3000"
